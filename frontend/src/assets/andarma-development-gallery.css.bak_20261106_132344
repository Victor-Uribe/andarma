/* ANDARMA_FASE3A_GALERIA_HERO - Exclusivo hero de desarrollos */
.ad3a-hero{position:relative;isolation:isolate;min-height:clamp(650px,90svh,990px);background:#04182e;color:#fff;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between}
.ad3a-hero__slides,.ad3a-hero__photo,.ad3a-hero__shade,.ad3a-hero__fallback{position:absolute;inset:0;z-index:-1}
.ad3a-hero__photo{background-position:center;background-repeat:no-repeat;background-size:cover;transform:scale(1.06);animation:ad3a-kenburns 7.2s linear both}
.ad3a-hero__fallback{background:linear-gradient(120deg,#062348,#081c35 45%,#035095)}
.ad3a-photo-enter-active{transition:opacity 1.15s cubic-bezier(.25,.65,.2,1),clip-path 1.2s cubic-bezier(.2,.7,.2,1)}
.ad3a-photo-leave-active{transition:opacity 1.1s ease}
.ad3a-photo-enter-from{opacity:0;clip-path:inset(0 0 0 100%)}
.ad3a-photo-enter-to{opacity:1;clip-path:inset(0 0 0 0)}
.ad3a-photo-leave-to{opacity:0}
@keyframes ad3a-kenburns{from{transform:scale(1.08)}to{transform:scale(1)}}
.ad3a-hero__shade{background:linear-gradient(90deg,rgba(3,17,37,.93) 0%,rgba(3,19,42,.78) 34%,rgba(2,16,35,.33) 76%),linear-gradient(0deg,rgba(3,15,33,.75),transparent 34%)}
.ad3a-hero__inner{width:100%;max-width:1600px;margin:0 auto;padding:clamp(155px,16vh,230px) clamp(24px,5vw,86px) 70px;position:relative}
.ad3a-hero__copy{max-width:760px;animation:ad3a-copy .75s ease both}
@keyframes ad3a-copy{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
.ad3a-hero__eyebrow{font:800 11px/1.4 'DM Sans',sans-serif;letter-spacing:.23em;color:#b9dcff}.ad3a-hero__eyebrow b{color:#30b0ff;padding:0 6px}
.ad3a-hero h1{font:800 clamp(47px,6vw,98px)/1.025 Manrope,sans-serif;letter-spacing:-.075em;margin:25px 0 21px;text-wrap:balance}
.ad3a-hero h1 strong{font-weight:800;color:#a9d9ff}.ad3a-hero__project{font:750 clamp(18px,2vw,27px)/1.3 Manrope,sans-serif;color:#fff;margin:0 0 17px}
.ad3a-hero__description{font-size:clamp(15px,1.1vw,18px);line-height:1.75;max-width:570px;color:#d9e8fa;margin:0;border-left:2px solid #0891ff;padding-left:18px;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.ad3a-hero__actions{display:flex;align-items:center;flex-wrap:wrap;gap:22px;margin-top:32px}
.ad3a-hero__cta{min-height:58px;display:inline-flex;align-items:center;gap:32px;background:#0066e0;border:1px solid #0066e0;color:#fff;text-decoration:none;padding:0 24px;font-size:12px;font-weight:800;letter-spacing:.07em;text-transform:uppercase;transition:background .2s,transform .2s}
.ad3a-hero__cta:hover{background:#0891ff;transform:translateY(-2px)}
.ad3a-hero__secondary{font-size:12px;font-weight:800;color:#fff;text-decoration:none;border-bottom:1px solid #a4c6e6;padding-bottom:8px;display:inline-flex;gap:15px;align-items:center}
.ad3a-hero__bottom{position:relative;z-index:2;min-height:92px;border-top:1px solid rgba(255,255,255,.22);padding:16px clamp(24px,5vw,86px);display:flex;align-items:center;justify-content:space-between;gap:20px}
.ad3a-hero__location{font-size:12px;font-weight:700;color:#d2e2f6}.ad3a-hero__location i{color:#75c5ff;margin-right:10px}
.ad3a-hero__nav{display:flex;align-items:center;gap:12px}.ad3a-hero__count{font:800 16px Manrope,sans-serif;min-width:65px}.ad3a-hero__count i{font-size:11px;color:#aac9e7;font-style:normal;padding:0 5px}
.ad3a-hero__progress{width:130px;height:2px;background:#ffffff66;overflow:hidden;margin:0 10px}.ad3a-hero__progress span{display:block;height:100%;background:#65cbff;transform-origin:left;animation:ad3a-progress 6.5s linear forwards}
@keyframes ad3a-progress{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.ad3a-hero__nav button{color:#fff;width:42px;height:42px;background:#ffffff16;border:1px solid #ffffff66;cursor:pointer;display:grid;place-items:center;transition:background .2s}
.ad3a-hero__nav button:hover{background:#0066e0}.ad3a-hero__nav button:focus-visible{outline:3px solid #7ed2ff;outline-offset:3px}
.ad3a-admin-gallery__input{display:block;margin:12px 0;width:100%}.ad3a-admin-gallery__list{display:grid;grid-template-columns:repeat(auto-fill,minmax(145px,1fr));gap:12px;margin-top:18px}
.ad3a-admin-gallery__item{padding:9px;background:#f5f9fd;border:1px solid #dbe8f5;border-radius:10px}.ad3a-admin-gallery__item img{display:block;width:100%;height:98px;object-fit:cover;border-radius:6px}
.ad3a-admin-gallery__buttons{display:flex;gap:5px;justify-content:space-between;padding-top:9px;flex-wrap:wrap}.ad3a-admin-gallery__buttons button{min-width:31px;min-height:32px;border:1px solid #cbddeb;background:#fff;border-radius:6px;color:#07569e;cursor:pointer}
.ad3a-admin-gallery__buttons button:disabled{opacity:.4;cursor:not-allowed}.ad3a-admin-gallery__buttons .ad3a-remove{color:#a12e3f}
.ad3a-admin-gallery__hint{font-size:12px;line-height:1.5;color:#657994}
@media(max-width:700px){.ad3a-hero{min-height:690px}.ad3a-hero__inner{padding:132px 22px 55px}.ad3a-hero h1{font-size:clamp(42px,10vw,59px)}.ad3a-hero__bottom{padding:14px 22px;align-items:flex-start;flex-direction:column}.ad3a-hero__progress{width:65px;margin:0}.ad3a-hero__nav{gap:8px}.ad3a-hero__nav button{width:38px;height:38px}}
@media(prefers-reduced-motion:reduce){.ad3a-hero__photo,.ad3a-hero__copy,.ad3a-hero__progress span{animation:none!important}.ad3a-photo-enter-active,.ad3a-photo-leave-active{transition:none!important}}

/* ANDARMA_FASE3B_GALERIA_UI */
.ad3a-admin-gallery{padding:18px 0 4px}
.ad3a-admin-gallery__hint{font-size:13px;line-height:1.65;margin:10px 0;color:#536b83}
.ad3b-upload-area{border:1px solid #d5e5f4;border-radius:15px;background:linear-gradient(145deg,#f7fbff 0%,#fff 80%);padding:20px;margin:17px 0 14px;box-shadow:0 9px 25px rgba(2,40,80,.04)}
.ad3b-upload-area.is-busy{opacity:.65;pointer-events:none}
.ad3b-upload-area__intro{display:flex;align-items:center;gap:13px;margin-bottom:13px}
.ad3b-upload-area__symbol{display:grid;place-items:center;width:46px;height:46px;flex:0 0 46px;border-radius:12px;color:#0066e0;background:#e6f1ff;font-size:21px}
.ad3b-upload-area__intro strong{display:block;font:750 15px/1.4 Manrope,'DM Sans',sans-serif;color:#123458}
.ad3b-upload-area__intro p{font:400 12px/1.65 'DM Sans',sans-serif;color:#5e7791;margin:3px 0 0}
.ad3b-upload-area .ad-dev37-image{max-width:100%}
.ad3b-upload-area .ad-dev37-upload-zone{width:100%;min-height:170px;border:1.5px dashed #9cbfe4;border-radius:12px;background:#fff;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:8px;padding:20px;color:#0a3a79;transition:border-color .25s,background .25s,transform .25s}
.ad3b-upload-area .ad-dev37-upload-zone:hover{border-color:#0066e0;background:#f2f8ff;transform:translateY(-1px)}
.ad3b-upload-area .ad-dev37-upload-zone strong{font-size:14px}
.ad3b-upload-area .ad-dev37-upload-zone small{color:#667f99;font-size:11px}
.ad3b-upload-area .ad-dev37-photo-preview img{width:100%;max-height:230px;object-fit:cover;border-radius:9px}
.ad3b-upload-area__note{font-size:12px;color:#52708f;line-height:1.6;margin:13px 0 0}
.ad3b-upload-area__note i{color:#0d9c76;margin-right:5px}
.ad3a-admin-gallery__list{grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:14px;margin-top:16px}
.ad3a-admin-gallery__item{background:white;border:1px solid #d9e6f4;border-radius:12px;padding:8px;box-shadow:0 6px 22px rgba(12,48,87,.06);transition:transform .2s,box-shadow .2s}
.ad3a-admin-gallery__item:hover{transform:translateY(-2px);box-shadow:0 12px 26px rgba(12,48,87,.11)}
.ad3a-admin-gallery__item img{width:100%;height:125px;object-fit:cover;border-radius:8px}
.ad3a-admin-gallery__buttons{justify-content:flex-end;gap:7px}
.ad3a-admin-gallery__buttons button{height:35px;min-width:35px;border-radius:7px}
.ad3a-admin-gallery__buttons button:hover:not(:disabled){background:#eaf4ff;border-color:#0066e0}
@media(max-width:580px){.ad3b-upload-area{padding:12px}.ad3a-admin-gallery__list{grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.ad3a-admin-gallery__item img{height:95px}}

/* ANDARMA_FASE3D_GALERIA_UNIFICADA */
.ad3d-gallery{padding:3px 0 9px!important;background:transparent!important;border:0!important;box-shadow:none!important}
.ad3d-gallery__heading{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:17px}
.ad3d-gallery__heading h3{font:800 19px/1.2 Manrope,'DM Sans',sans-serif;color:#102d50;margin:5px 0}
.ad3d-gallery__heading p{color:#647990;font-size:13px;line-height:1.5;margin:0}
.ad3d-gallery__count{white-space:nowrap;background:#eaf3ff;color:#0066e0;border-radius:99px;padding:6px 11px;font-size:12px;font-weight:750}
.ad3d-gallery__toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:14px;margin-bottom:18px}
.ad3d-gallery__toolbar span{font-size:12px;color:#647991}
.ad3d-gallery__editor{padding:16px;border-radius:14px;border:1px solid #bed5ed;background:#f7fbff;margin:14px 0 19px}
.ad3d-gallery__editor-head{display:flex;align-items:center;justify-content:space-between;gap:10px}
.ad3d-gallery__editor-head strong{font-size:14px;color:#0d315a}
.ad3d-gallery__editor>p{color:#657c94;font-size:12px;margin:7px 0 12px}
.ad3d-gallery__editor .ad-dev37-upload-zone{width:100%;min-height:130px;border:1px dashed #aac8e5;background:#fff;border-radius:11px}
.ad3d-gallery__editor .ad-dev37-upload-zone:hover{background:#f2f8ff;border-color:#0066e0}
.ad3d-gallery__editor .ad-dev37-image{width:100%}
.ad3d-gallery__loading{color:#416d98;font-size:12px;margin:10px 0}
.ad3d-gallery__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:14px}
.ad3d-gallery__card{min-width:0;border:1px solid #dce6f1;border-radius:13px;background:#fff;overflow:hidden;box-shadow:0 6px 18px #102b4c0b}
.ad3d-gallery__card.is-primary{border-color:#3d99fb;box-shadow:0 0 0 1px #65b2ff33,0 8px 22px #0b4b9920}
.ad3d-gallery__preview{aspect-ratio:16/9;position:relative;overflow:hidden;background:#eaf2f9}
.ad3d-gallery__preview img{width:100%;height:100%;object-fit:cover;display:block;border-radius:0}
.ad3d-gallery__primary-badge,.ad3d-gallery__index{position:absolute;left:10px;top:10px;padding:6px 9px;border-radius:7px;background:#0066e0;color:#fff;font:750 11px/1.2 'DM Sans',sans-serif}
.ad3d-gallery__index{background:#051e3eb5}
.ad3d-gallery__card-body{padding:11px}
.ad3d-gallery__set-primary{background:#eff6ff;border:1px solid #d2e6ff;border-radius:8px;padding:8px 9px;min-height:34px;width:100%;font-size:12px;font-weight:700;color:#0066e0;cursor:pointer}
.ad3d-gallery__set-primary:hover{background:#dfeeff}
.ad3d-gallery__current-primary{font-size:11px;color:#34729d;min-height:34px;display:flex;align-items:center;line-height:1.35}
.ad3d-gallery__actions{display:flex;align-items:center;gap:5px;margin-top:9px}
.ad3d-gallery__actions button{background:#fff;border:1px solid #d4e2f1;border-radius:7px;min-width:31px;height:34px;padding:0 8px;display:inline-flex;align-items:center;justify-content:center;gap:6px;color:#174b78;cursor:pointer}
.ad3d-gallery__actions button:first-child{flex:1;font-size:11px;font-weight:700}
.ad3d-gallery__actions button:disabled{cursor:not-allowed;opacity:.38}
.ad3d-gallery__actions button:hover:not(:disabled){border-color:#0066e0;background:#f0f7ff;color:#0066e0}
.ad3d-gallery__actions button.ad3d-gallery__delete{color:#a23d49}
.ad3d-gallery__empty{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:10px;padding:35px 18px;text-align:center;border:1px dashed #b8cee6;border-radius:14px;background:#f8fbff;color:#657d97}
.ad3d-gallery__empty i{font-size:28px;color:#167bec}
.ad3d-gallery__empty strong{color:#153d67;font-size:14px}
.ad3d-gallery__empty span{font-size:12px;line-height:1.5}
@media(max-width:570px){.ad3d-gallery__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}.ad3d-gallery__card-body{padding:7px}.ad3d-gallery__actions{flex-wrap:wrap}.ad3d-gallery__actions button:first-child{flex-basis:100%}.ad3d-gallery__heading{align-items:center}.ad3d-gallery__heading h3{font-size:16px}}

/* ANDARMA_FASE3E_HERO_PUBLICO - Ajustes aislados, sin afectar homepage ni mapas */
/* Galería: acción de reemplazo en toda una fila para no desbordar las miniaturas. */
.ad3d-gallery__card .ad3d-gallery__actions{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;min-width:0!important;align-items:stretch!important}
.ad3d-gallery__card .ad3d-gallery__actions button{box-sizing:border-box!important;min-width:0!important;width:100%!important;max-width:100%!important;min-height:34px!important;height:auto!important;overflow:hidden!important;flex:none!important}
.ad3d-gallery__card .ad3d-gallery__actions button:first-child{grid-column:1 / -1!important;display:inline-flex!important;justify-content:center!important;gap:8px!important;padding:9px 10px!important;white-space:nowrap!important;font-size:12px!important;line-height:1.3!important}
.ad3d-gallery__card .ad3d-gallery__actions button:first-child span{min-width:0!important;overflow:hidden!important;text-overflow:ellipsis!important}
.ad3d-gallery__card .ad3d-gallery__actions button:not(:first-child){display:grid!important;place-items:center!important;padding:8px!important}
